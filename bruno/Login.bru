meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Accept: application/json
}

body:json {
  {
    "email": "user@example.com",
    "password": "12345678"
  }
}

assert {
  res.status: eq 200
}

script:post-response {
  bru.setVar("token", res.body.token);
}
